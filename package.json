{
  "name": "revops-agent-orchestration",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b packages/core packages/sandbox packages/connectors packages/mcp-server packages/engine packages/orchestrator && tsc -p tsconfig.tests.json",
    "test": "vitest run --root .",
    "lint": "biome check packages scripts evals apps/console/src apps/console/e2e",
    "sandbox": "tsx packages/sandbox/src/main.ts",
    "orchestrator": "tsx packages/orchestrator/src/main.ts",
    "mcp": "tsx packages/mcp-server/src/main.ts",
    "eval": "tsx evals/run.ts",
    "gate": "tsx evals/gate.ts",
    "dev": "tsx packages/orchestrator/src/main.ts --local",
    "history": "tsx scripts/export-history.ts",
    "heldout": "tsx evals/run.ts --heldout",
    "console:test": "npm -w @revops/console test",
    "console:e2e": "npm -w @revops/console run e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-js": "^18.6.2",
    "bpmnlint": "^11.6.0",
    "bpmnlint-plugin-camunda-compat": "^2.63.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@camunda8/orchestration-cluster-api": "^8.8.5",
    "@camunda8/sdk": "^8.8.18",
    "@fastify/multipart": "^9.0.3",
    "@google-cloud/bigquery": "^7.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "alasql": "^4.6.2",
    "bpmn-moddle": "^9.0.1",
    "dmn-moddle": "^10.0.0",
    "fastify": "^5.2.0",
    "feelin": "^8.2.0",
    "jsforce": "^3.6.2",
    "pino": "^9.5.0",
    "undici": "^7.2.0",
    "yaml": "^2.6.1",
    "zeebe-bpmn-moddle": "^2.0.0",
    "zod": "^3.25.76"
  }
}
