<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_DealRegistration" targetNamespace="https://revops.example/processes" exporter="revops-agent-orchestration" exporterVersion="0.1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="partner-deal-registration" name="Partner deal registration" isExecutable="true">
    <bpmn:documentation>A partner registers a deal in Impartner. The conflict check is code (open direct opportunities, other partners' approved registrations), the policy is a DMN table, and the message to the partner is drafted by Claude from the reason code. The automation may approve a clean registration below the limit on its own; only a person rejects a partner's registration.</bpmn:documentation>
    <bpmn:startEvent id="RegistrationSubmitted" name="Registration submitted">
      <bpmn:outgoing>Flow_ToConflicts</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_RegistrationSubmitted" messageRef="Message_RegistrationSubmitted" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="CheckConflicts" name="Check for channel conflicts">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="dealreg.conflicts" retries="5" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToConflicts</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPolicy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="ApplyPolicy" name="Apply the registration policy">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="deal-registration-policy" resultVariable="policyDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPolicy</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDraft</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="DraftMessage" name="Draft the message to the partner">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent.dealreg.draft" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDraft</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPolicyGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PolicyGateway" name="May the automation decide?" default="Flow_NeedsDealDesk">
      <bpmn:incoming>Flow_ToPolicyGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_NeedsDealDesk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="PolicyApproves" name="Approve by policy">
      <bpmn:extensionElements>
        <zeebe:script expression="={outcome: &#34;approve&#34;, by: &#34;policy:partner-deal-registration&#34;, edits: null}" resultVariable="decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AutoApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoToResolve</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="AskDealDesk" name="Ask the deal desk in Slack">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="slack.approval.request" retries="5" />
        <zeebe:taskHeaders>
          <zeebe:header key="kind" value="deal_registration" />
          <zeebe:header key="channel" value="deal_registration" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NeedsDealDesk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDealDeskDecides</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="DealDeskDecides" name="Deal desk decides" messageRef="Message_ApprovalDecided">
      <bpmn:incoming>Flow_ToDealDeskDecides</bpmn:incoming>
      <bpmn:outgoing>Flow_DeskToResolve</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="ResponseDeadline" name="Response promised to the partner" attachedToRef="DealDeskDecides">
      <bpmn:outgoing>Flow_ToEscalateDesk</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_ResponseDeadline">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=policy.decisionDeadline</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="DailyReminder" name="Every morning" cancelActivity="false" attachedToRef="DealDeskDecides">
      <bpmn:outgoing>Flow_ToRemindDesk</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_DailyReminder">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R2/P1D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="RemindDesk" name="Remind the deal desk">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="slack.notify" retries="5" />
        <zeebe:taskHeaders>
          <zeebe:header key="channel" value="deal_registration" />
          <zeebe:header key="template" value="dealreg_reminder" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRemindDesk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReminded</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="DeskReminded" name="Reminded">
      <bpmn:incoming>Flow_ToReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="EscalateDesk" name="Escalate to the head of partnerships">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="slack.notify" retries="5" />
        <zeebe:taskHeaders>
          <zeebe:header key="channel" value="deal_registration_escalation" />
          <zeebe:header key="template" value="dealreg_escalation" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEscalateDesk</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEscalated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="RegistrationEscalated" name="Escalated">
      <bpmn:incoming>Flow_ToEscalated</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="ResolveDecision" name="Settle the decision">
      <bpmn:extensionElements>
        <zeebe:script expression="=if decision.outcome = &#34;edit&#34; then decision.edits.decision else if decision.outcome = &#34;approve&#34; and decision.by = &#34;policy:partner-deal-registration&#34; then &#34;approve&#34; else if decision.outcome = &#34;approve&#34; then policyDecision.suggestion else &#34;none&#34;" resultVariable="finalDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AutoToResolve</bpmn:incoming>
      <bpmn:incoming>Flow_DeskToResolve</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecided</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="DecidedGateway" name="Decision to record?" default="Flow_Record">
      <bpmn:incoming>Flow_ToDecided</bpmn:incoming>
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
      <bpmn:outgoing>Flow_Record</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="HandledManually" name="Deal desk handles it">
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="IssueDealApproval" name="Issue the approval">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="approval.issue" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="={decide: if finalDecision = &#34;approve&#34; then plan.writes.approve else plan.writes.reject}" target="writes" />
          <zeebe:input source="=decision.by" target="approvedBy" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecide</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="DecideInImpartner" name="Record the decision in Impartner">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mcp.call" retries="5" />
        <zeebe:taskHeaders>
          <zeebe:header key="tool" value="prm_decide_registration" />
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=if finalDecision = &#34;approve&#34; then plan.writes.approve.args else plan.writes.reject.args" target="args" />
          <zeebe:input source="=approvals.decide" target="approval" />
          <zeebe:output source="=toolResult" target="decisionResult" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDecide</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyManager</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="NotifyPartnerManager" name="Tell the partner manager">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="slack.notify" retries="5" />
        <zeebe:taskHeaders>
          <zeebe:header key="channel" value="deal_registration" />
          <zeebe:header key="template" value="dealreg_decided" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotifyManager</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRegistrationDecided</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="RegistrationDecided" name="Registration decided">
      <bpmn:incoming>Flow_ToRegistrationDecided</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToConflicts" sourceRef="RegistrationSubmitted" targetRef="CheckConflicts" />
    <bpmn:sequenceFlow id="Flow_ToPolicy" sourceRef="CheckConflicts" targetRef="ApplyPolicy" />
    <bpmn:sequenceFlow id="Flow_ToDraft" sourceRef="ApplyPolicy" targetRef="DraftMessage" />
    <bpmn:sequenceFlow id="Flow_ToPolicyGateway" sourceRef="DraftMessage" targetRef="PolicyGateway" />
    <bpmn:sequenceFlow id="Flow_AutoApprove" name="clean and below the limit" sourceRef="PolicyGateway" targetRef="PolicyApproves">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=policyDecision.decision = "approve" and policy.mode = "auto"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NeedsDealDesk" name="needs a person" sourceRef="PolicyGateway" targetRef="AskDealDesk" />
    <bpmn:sequenceFlow id="Flow_AutoToResolve" sourceRef="PolicyApproves" targetRef="ResolveDecision" />
    <bpmn:sequenceFlow id="Flow_ToDealDeskDecides" sourceRef="AskDealDesk" targetRef="DealDeskDecides" />
    <bpmn:sequenceFlow id="Flow_DeskToResolve" sourceRef="DealDeskDecides" targetRef="ResolveDecision" />
    <bpmn:sequenceFlow id="Flow_ToRemindDesk" sourceRef="DailyReminder" targetRef="RemindDesk" />
    <bpmn:sequenceFlow id="Flow_ToReminded" sourceRef="RemindDesk" targetRef="DeskReminded" />
    <bpmn:sequenceFlow id="Flow_ToEscalateDesk" sourceRef="ResponseDeadline" targetRef="EscalateDesk" />
    <bpmn:sequenceFlow id="Flow_ToEscalated" sourceRef="EscalateDesk" targetRef="RegistrationEscalated" />
    <bpmn:sequenceFlow id="Flow_ToDecided" sourceRef="ResolveDecision" targetRef="DecidedGateway" />
    <bpmn:sequenceFlow id="Flow_Manual" name="no decision" sourceRef="DecidedGateway" targetRef="HandledManually">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=finalDecision = "none"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Record" sourceRef="DecidedGateway" targetRef="IssueDealApproval" />
    <bpmn:sequenceFlow id="Flow_ToDecide" sourceRef="IssueDealApproval" targetRef="DecideInImpartner" />
    <bpmn:sequenceFlow id="Flow_ToNotifyManager" sourceRef="DecideInImpartner" targetRef="NotifyPartnerManager" />
    <bpmn:sequenceFlow id="Flow_ToRegistrationDecided" sourceRef="NotifyPartnerManager" targetRef="RegistrationDecided" />
  </bpmn:process>
  <bpmn:message id="Message_RegistrationSubmitted" name="impartner.registration.submitted" />
  <bpmn:message id="Message_ApprovalDecided" name="approval.decided">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=approvalId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_partner-deal-registration">
    <bpmndi:BPMNPlane id="BPMNPlane_partner-deal-registration" bpmnElement="partner-deal-registration">
      <bpmndi:BPMNShape id="RegistrationSubmitted_di" bpmnElement="RegistrationSubmitted">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckConflicts_di" bpmnElement="CheckConflicts">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApplyPolicy_di" bpmnElement="ApplyPolicy">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DraftMessage_di" bpmnElement="DraftMessage">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PolicyGateway_di" bpmnElement="PolicyGateway" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PolicyApproves_di" bpmnElement="PolicyApproves">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ResolveDecision_di" bpmnElement="ResolveDecision">
        <dc:Bounds x="1075" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DecidedGateway_di" bpmnElement="DecidedGateway" isMarkerVisible="true">
        <dc:Bounds x="1250" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HandledManually_di" bpmnElement="HandledManually">
        <dc:Bounds x="1407" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AskDealDesk_di" bpmnElement="AskDealDesk">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DealDeskDecides_di" bpmnElement="DealDeskDecides">
        <dc:Bounds x="925" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ResponseDeadline_di" bpmnElement="ResponseDeadline">
        <dc:Bounds x="940.3333333333334" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DailyReminder_di" bpmnElement="DailyReminder">
        <dc:Bounds x="973.6666666666666" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IssueDealApproval_di" bpmnElement="IssueDealApproval">
        <dc:Bounds x="1375" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DecideInImpartner_di" bpmnElement="DecideInImpartner">
        <dc:Bounds x="1525" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyPartnerManager_di" bpmnElement="NotifyPartnerManager">
        <dc:Bounds x="1675" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RegistrationDecided_di" bpmnElement="RegistrationDecided">
        <dc:Bounds x="1857" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RemindDesk_di" bpmnElement="RemindDesk">
        <dc:Bounds x="1075" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DeskReminded_di" bpmnElement="DeskReminded">
        <dc:Bounds x="1257" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EscalateDesk_di" bpmnElement="EscalateDesk">
        <dc:Bounds x="1075" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RegistrationEscalated_di" bpmnElement="RegistrationEscalated">
        <dc:Bounds x="1257" y="472" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToConflicts_di" bpmnElement="Flow_ToConflicts">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPolicy_di" bpmnElement="Flow_ToPolicy">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDraft_di" bpmnElement="Flow_ToDraft">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPolicyGateway_di" bpmnElement="Flow_ToPolicyGateway">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="650" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoApprove_di" bpmnElement="Flow_AutoApprove">
        <di:waypoint x="700" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NeedsDealDesk_di" bpmnElement="Flow_NeedsDealDesk">
        <di:waypoint x="675" y="95" />
        <di:waypoint x="675" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoToResolve_di" bpmnElement="Flow_AutoToResolve">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="1075" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDecided_di" bpmnElement="Flow_ToDecided">
        <di:waypoint x="1175" y="70" />
        <di:waypoint x="1250" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manual_di" bpmnElement="Flow_Manual">
        <di:waypoint x="1300" y="70" />
        <di:waypoint x="1407" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Record_di" bpmnElement="Flow_Record">
        <di:waypoint x="1275" y="95" />
        <di:waypoint x="1275" y="210" />
        <di:waypoint x="1375" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDealDeskDecides_di" bpmnElement="Flow_ToDealDeskDecides">
        <di:waypoint x="875" y="210" />
        <di:waypoint x="925" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DeskToResolve_di" bpmnElement="Flow_DeskToResolve">
        <di:waypoint x="1025" y="210" />
        <di:waypoint x="1125" y="210" />
        <di:waypoint x="1125" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEscalateDesk_di" bpmnElement="Flow_ToEscalateDesk">
        <di:waypoint x="958.3333333333334" y="268" />
        <di:waypoint x="958.3333333333334" y="490" />
        <di:waypoint x="1075" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRemindDesk_di" bpmnElement="Flow_ToRemindDesk">
        <di:waypoint x="991.6666666666666" y="268" />
        <di:waypoint x="991.6666666666666" y="350" />
        <di:waypoint x="1075" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDecide_di" bpmnElement="Flow_ToDecide">
        <di:waypoint x="1475" y="210" />
        <di:waypoint x="1525" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToNotifyManager_di" bpmnElement="Flow_ToNotifyManager">
        <di:waypoint x="1625" y="210" />
        <di:waypoint x="1675" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRegistrationDecided_di" bpmnElement="Flow_ToRegistrationDecided">
        <di:waypoint x="1775" y="210" />
        <di:waypoint x="1857" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToReminded_di" bpmnElement="Flow_ToReminded">
        <di:waypoint x="1175" y="350" />
        <di:waypoint x="1257" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEscalated_di" bpmnElement="Flow_ToEscalated">
        <di:waypoint x="1175" y="490" />
        <di:waypoint x="1257" y="490" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
